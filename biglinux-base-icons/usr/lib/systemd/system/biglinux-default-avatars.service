[Unit]
Description=Give new users a BigLinux avatar
ConditionPathExists=/usr/share/dbus-1/system-services/org.freedesktop.Accounts.service
Before=display-manager.service

[Service]
Type=oneshot
# A user whose avatar is not set in time is retried on the next run.
TimeoutStartSec=15s
ExecStart=/usr/lib/biglinux-base-icons/default-avatars
ProtectSystem=strict
ReadWritePaths=/var/lib/AccountsService/icons
StateDirectory=biglinux-base-icons
ProtectHome=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0022
